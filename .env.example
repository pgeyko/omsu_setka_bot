# === Timezone ===
TZ=Asia/Omsk

# === Telegram ===
BOT_TOKEN=your_bot_token_here
GROUP_ID=-1000000000000
OMSU_GROUP_ID=12345

# === LLM Provider Keys ===
GEMINI_API_KEY=your_gemini_api_key        # gemma-4-31b-it, gemini-3.1-flash-lite
GEMINI_RESERVE_API_KEY=your_gemini_reserve_key  # запасной ключ (fallback)
DEEPSEEK_API_KEY=your_deepseek_api_key    # финальный резерв для текста

# === Admin API ===
ADMIN_SECRET=your-admin-secret
JWT_SECRET=your-jwt-secret
API_LISTEN=:8081
CORS_ORIGIN=*

# === Webhook (from omsu_setka) ===
SCHEDULE_WEBHOOK_SECRET=your-webhook-secret
ANNOUNCE_THREAD_ID=10

# === Database ===
DB_PATH=./data/groupbot.db

# === Rate Limiting ===
RATE_LIMIT_GLOBAL_PER_USER=5
RATE_LIMIT_SUMMARY_PER_USER=30

# === LLM ===
DAILY_TOKEN_LIMIT=100000
CLASSIFY_CONFIDENCE_THRESHOLD=0.75
LLM_REQUEST_TIMEOUT_SEC=30
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_MIN=5
LLM_SKIP_FALLBACK_MODEL=false

# === omsu_setka integration (optional) ===
SETKA_BASE_URL=http://omsu_mirror:8080
SETKA_ADMIN_KEY=your-setka-admin-key
SETKA_PUBLIC_URL=https://setka.pgeyko.ru

# === Logging ===
LOG_LEVEL=info       # debug / info / warn / error
LOG_FORMAT=text      # text / json

# === Environment ===
APP_ENV=development
SWAGGER_ENABLED=false

# === Config path (optional override) ===
CONFIG_PATH=config.yaml
